<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file for the common-lib module (the Maven equivalent of a package.json for one
  workspace package). Maven reads it to know the module's coordinates, what it depends on and
  how to build it. Everything not declared here is inherited from the parent (the root pom.xml).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Version of the POM file format itself (always 4.0.0), not of this project. -->
    <modelVersion>4.0.0</modelVersion>
    <!-- Inherit config (Java version, dependency versions, plugins) from the root pom.
         Similar to a shared tsconfig "extends" plus a workspace root package.json.
         groupId + artifactId + version ("GAV") uniquely identify any Maven artifact,
         like "@homefin/homefin-platform@0.1.0" would on npm. -->
    <parent>
        <groupId>com.homefin</groupId>
        <artifactId>homefin-platform</artifactId>
        <!-- SNAPSHOT = a mutable dev version (like 0.1.0-dev); released versions drop the suffix. -->
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- A plain library JAR (NOT an executable Spring Boot app).
         Shared by the servlet-based services: error model, event contracts, security defaults.
         groupId and version are omitted here because they are inherited from the parent. -->
    <artifactId>common-lib</artifactId>
    <name>common-lib</name>

    <!-- Like "dependencies" in package.json. No versions here: the parent imports the Spring Boot
         BOM (bill of materials), which pins a tested version for every Spring library. -->
    <dependencies>
        <!-- Spring MVC + embedded Tomcat + Jackson (JSON). Roughly "express" + "body-parser". -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring Security support for validating incoming JWT bearer tokens. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Bean Validation (Hibernate Validator): annotations like @NotBlank, similar to zod/class-validator. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Needed to write our own auto-configuration (see CommonWebAutoConfiguration). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- optional: only services that use JPA get it (they declare the starter themselves).
             optional=true means "compile against it, but don't pass it on to modules that depend on
             common-lib" - a bit like a peerDependency in npm. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Lombok: a compile-time code generator (getters, constructors, loggers) driven by
             annotations. It runs inside the compiler, so it is not needed at runtime. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
