<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file for the api-gateway module (like the package.json of one workspace package).
  Builds an executable Spring Boot app: the single public entry point that routes requests
  to the backend services.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Version of the POM format itself; always 4.0.0. -->
    <modelVersion>4.0.0</modelVersion>
    <!-- Inherit shared settings and managed dependency versions from the root pom.xml. -->
    <parent>
        <groupId>com.homefin</groupId>
        <artifactId>homefin-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <!-- This module's name (groupId/version are inherited). -->
    <artifactId>api-gateway</artifactId>
    <name>api-gateway</name>

    <!-- The gateway is REACTIVE (WebFlux/Netty), so it does NOT use common-lib (servlet based).
         "Reactive" = non-blocking, event-loop based I/O, the same model as Node.js itself.
         Dependency versions are not written here: the BOMs in the root pom manage them. -->
    <dependencies>
        <!-- Spring Cloud Gateway on WebFlux: a programmable reverse proxy (like http-proxy-middleware
             or an nginx config, but in Java). -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!-- Eureka client: registers the gateway and resolves "lb://service-name" route URIs. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!-- Config client: fetches shared configuration from config-server at startup. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- Validates incoming JWT bearer tokens (the gateway's edge authentication). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Actuator: /actuator/health, metrics, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Distributed tracing: Micrometer Tracing backed by OpenTelemetry... -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- ...exporting spans over OTLP (to Jaeger in docker compose). -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- scope=runtime: not needed to compile, only on the classpath when the app runs.
             Adds the /actuator/prometheus metrics endpoint. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Lombok: compile-time code generation (@Slf4j logger etc.); optional = not passed on. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- scope=test: test-only dependency (JUnit 5, AssertJ, Mockito), like a devDependency. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Packages the app as an executable fat JAR ("java -jar api-gateway.jar"). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
