<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root (parent) POM of the multi-module build.
  Think of it as a monorepo root package.json + a shared tsconfig:
  it pins versions (dependencyManagement) and build settings (pluginManagement)
  once, and every module inherits them.

  Common commands (run from this folder; "mvn" is Maven, the npm/yarn of Java):
    mvn test       compile everything and run unit tests
    mvn verify     also run integration tests (*IT classes)
    mvn package    build the JARs into each module's target/ folder (like dist/)
  Maven downloads dependencies into ~/.m2/repository (a global cache, unlike per-project node_modules).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Version of the POM file format (always 4.0.0), not of this project. -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit Spring Boot's curated dependency versions + plugin config -->
    <!-- A parent is identified by its coordinates: groupId (organisation, reverse domain name),
         artifactId (package name) and version. Like "extends" pointing at a published npm package. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <!-- Empty relativePath = don't look for the parent on disk; fetch it from Maven Central. -->
        <relativePath/>
    </parent>

    <!-- This project's own coordinates, inherited by every module (they only set their artifactId).
         SNAPSHOT marks a development version that may change, unlike a fixed release. -->
    <groupId>com.homefin</groupId>
    <artifactId>homefin-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- packaging=pom: this project produces no JAR itself; it only aggregates and configures modules. -->
    <packaging>pom</packaging>
    <name>HomeFin Platform</name>
    <description>Reference Spring Boot microservices platform (property finance domain)</description>

    <!-- The sub-projects built together, like "workspaces" in a root package.json.
         Maven works out the build order from their dependencies (common-lib first). -->
    <modules>
        <module>common-lib</module>
        <module>config-server</module>
        <module>discovery-server</module>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>customer-service</module>
        <module>application-service</module>
    </modules>

    <!-- Named values usable anywhere as ${name} (like variables); some are read by plugins directly.
         java.version is used by the Spring Boot parent to set the compiler's Java language level. -->
    <properties>
        <java.version>21</java.version>
        <!-- keep in sync with the parent version above (used for annotation processor paths) -->
        <spring-boot.version>3.5.6</spring-boot.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versions NOT managed by Spring Boot -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>2.8.9</springdoc.version>
        <resilience4j.version>2.3.0</resilience4j.version>
    </properties>

    <!-- dependencyManagement pins versions WITHOUT adding dependencies: a module that declares e.g.
         mapstruct gets this version automatically. Similar to pnpm "overrides" / a shared catalog. -->
    <dependencyManagement>
        <dependencies>
            <!-- Resilience4j BOM FIRST: Spring Cloud's BOM also manages resilience4j-* modules.
                 Declaring ours first keeps ALL resilience4j jars on one version (mixing versions
                 breaks startup with "Error processing condition on ...FallbackConfigurationOnMissingBean"). -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <!-- type=pom + scope=import: copy the version list of this BOM ("bill of materials")
                     into our dependencyManagement. For conflicting entries the first declaration wins. -->
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM: Gateway, Config, Eureka, OpenFeign ... -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Our own shared library -->
            <dependency>
                <groupId>com.homefin</groupId>
                <artifactId>common-lib</artifactId>
                <!-- ${project.version} = this pom's own version (0.1.0-SNAPSHOT). -->
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Build settings. pluginManagement configures plugins for modules that USE them;
         the plugins section further down actually activates a plugin for every module. -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Annotation processors = compile-time code generation (like a TS transformer) -->
                <!-- The compiler plugin runs javac. Each processor below runs inside javac:
                     Lombok (getters/constructors/loggers), MapStruct (DTO mappers), the Lombok+MapStruct
                     ordering binding, and Spring Boot's processor (IDE autocompletion for app.* YAML keys). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <!-- lombok.version is defined by the Spring Boot parent. -->
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <version>${spring-boot.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <!-- Don't copy Lombok into the executable JAR: it's only needed at compile time. -->
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Unit tests (*Test) run with surefire in `mvn test`;
                 integration tests (*IT) run with failsafe in `mvn verify`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
